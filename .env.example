# Cordée configuration. Copy to .env and fill in what you use. Never commit .env.
# The AINGEL_* prefix is historical (the project's former name); it is the
# current, supported name for every variable below.

# ── Storage ──────────────────────────────────────────────────────────────────
# Folder holding one sub-folder per project. Default: projects/ beside the code.
# AINGEL_PROJECTS_ROOT=/srv/cordee/projects
# Soft-delete trash, kept OUTSIDE the projects folder so agent tools cannot
# reach deleted files. Default: trash/ beside the code.
# AINGEL_TRASH_ROOT=/srv/cordee/trash

# ── Model providers (set the ones you use) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
# Mistral two-key setup (see SETUP.md → "Environment variables").
# VIBE key: APIKeyScope.vibe — Pro subscription, included quota.
#   Powers direct-API mode ("Guide my prompt") AND the Vibe 'mistral-vibe' provider.
# ORG key: APIKeyScope.organization — PAYG.
#   Powers the Vibe 'mistral-org' provider (Mistral Large).
MISTRAL_VIBE_KEY=...
MISTRAL_ORG_KEY=...
# Scaleway Generative APIs (EU): required for scw-* models and eu_only projects.
SCALEWAY_API_KEY=
# Ollama Cloud (oll-* models). Leave empty for a local Ollama.
# OLLAMA_API_KEY=

# Provider routing modes (see READMEFIRST.md → "Runtime Safety Notes").
# ANTHROPIC_MODE:  'claude-code' = route via the claude CLI (Pro/Max billing),
#                  'api' = direct Anthropic SDK calls (API credits).
ANTHROPIC_MODE=claude-code
# MISTRAL_MODE:    'vibe' = route via the Vibe CLI (tool use, Le Chat Pro billing),
#                  'api'  = direct mistralai SDK (text-only, API credits).
MISTRAL_MODE=vibe
# Comma-separated allowlist of Mistral model IDs routable through the Vibe CLI.
VIBE_MODELS=mistral-large-latest,mistral-glm-5-3
# Maximum cost in USD per Vibe task.
# VIBE_MAX_PRICE=15.00

# Local debugging only — bypass per-project permission gating. Leave unset in
# normal operation.
# CLAUDE_CODE_SKIP_PERMISSIONS=false
# VIBE_SKIP_PERMISSIONS=false

# ── Scaleway encrypted sessions (optional, eu_only projects) ────────────────
# Per-project Scaleway Project + KMS-encrypted bucket, crypto-shredded on close.
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_ORGANIZATION_ID=
# SCW_PROJECT_ID=

# Instance identity. Empty/absent = generic install (is_vault=false).
# 'Vault' unlocks vault-only features (Scaleway sessions, RAG corpora) and the
# IS_VAULT badge; only set it on a host prepared for them.
#AINGEL_INSTANCE_NAME=
# Timezone for schedules and budget periods.
# AINGEL_TZ=Europe/Paris

# ── Multi-user auth (agent_auth.py) ─────────────────────────────────────────
# AINGEL_AUTH: 'off' (default — single-user install, no login) or 'oidc'
# (OpenID Connect login, e.g. Authentik or Keycloak, with session cookies).
AINGEL_AUTH=off
# Required when AINGEL_AUTH=oidc — Flask session signing key. The app REFUSES
# to boot in oidc mode without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AINGEL_SESSION_SECRET=
# OIDC provider: issuer base URL, plus the client ID / secret of the
# application registered for this instance.
AINGEL_OIDC_ISSUER=https://auth.example.com/application/o/cordee/
AINGEL_OIDC_CLIENT_ID=
AINGEL_OIDC_CLIENT_SECRET=
# External origin when the app sits behind a TLS-terminating proxy/tunnel
# (e.g. Cloudflare → cloudflared → Flask over plain HTTP). Without it, the OIDC
# redirect_uri is derived from the request and comes out as http://, which
# strict redirect-URI matching rejects. Set to the public origin,
# e.g. https://cordee.example (no trailing slash).
AINGEL_PUBLIC_URL=
# Free-tier monthly token cap (in + out) per user, when auth is on.
# AINGEL_FREE_MAX_TOKENS=100000

# ── WebDAV (docs/WEBDAV_SETUP.md) ───────────────────────────────────────────
# Shared secret for WebDAV mounts (used as the password). Without it every
# WebDAV request is refused. It grants access to ALL projects: operator only.
# AINGEL_DAV_TOKEN=
# Dedicated WebDAV host that serves /<slug>/ without the /dav prefix.
# Default: any host whose name starts with "dav.".
# AINGEL_DAV_HOST=dav.cordee.example
# Trust X-Forwarded-User / X-Authentik-* identity headers. Only behind a proxy
# that injects them AND strips client-supplied copies.
# AINGEL_DAV_TRUST_HEADERS=1

# ── Server / backups ─────────────────────────────────────────────────────────
# Keep 127.0.0.1 behind a reverse proxy or tunnel; never 0.0.0.0 on a shared host.
# AINGEL_BIND_HOST=127.0.0.1
# Waitress pool. Each open browser tab holds one thread (SSE), each
# /api/execute call holds one for the whole run.
# AINGEL_WAITRESS_THREADS=64
# AINGEL_WAITRESS_CONNECTIONS=256
# Max request body in bytes (uploads, WebDAV PUT). Default 128 MiB.
# AINGEL_MAX_CONTENT_LENGTH=134217728
# Backups (ops/examples/backup.sh): central-DB snapshot folder, and an
# optional off-host copy (rclone remote:path).
# AINGEL_BACKUP_DIR=/var/backups/cordee
# AINGEL_BACKUP_RCLONE_REMOTE=s3:cordee-backups
