# ── Secrets ───────────────────────────────────────────────────────────────
# Never commit real API keys. .env.example IS tracked as the template.
.env
.env.bak-*
*.env.bak*
.secrets/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Node ───────────────────────────────────────────────────────────────────
node_modules/
# Root-level Playwright MCP tooling leftovers — the app's real deps live in
# frontend/package.json, not here.
/package.json
/package-lock.json

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
nohup.out

# ── Editor lock files (e.g. .~lock..env#) ─────────────────────────────────
.~lock.*

# ── Database (runtime state, not source) ────────────────────────────────────
# superagent.db is the source of truth for task state, but it's a constantly
# changing binary file — wrong fit for git. Back it up separately.
superagent.db
superagent.db.*
*.db
*.db-wal
*.db-shm

# ── Default runtime data dirs (agent_config, when the env vars are unset) ──
/projects/
/trash/

# ── Snapshot / promotion backup copies (superseded by git history) ──────────
# Note: `*.db` above does NOT match `p1.db.pre-pathfix-20260720`, because the
# extension isn't last. The catch-all below covers every `.pre-<label>-<stamp>`
# snapshot regardless of what it's a snapshot of.
*.pre-*
*.bak-*
*.backup-*

# ── Execution artifacts (auto-generated each run) ───────────────────────────
Artifacts/outputs/
Artifacts/chats/
Artifacts/*.memory.md
Artifacts/*.chat.md

# ── Merge staging (contains a live .env snapshot with real keys) ─────────────
.merge-in/

# ── Frontend test output (regenerated by every Playwright run) ──────────────
frontend/playwright-report/
frontend/test-results/
.playwright-mcp/

# ── Screenshots / scratch captures ──────────────────────────────────────────
# UI captures used while iterating; not source. Keep them out of history.
/*.png
/*.jpeg
/*.jpg
uploads/

# ── Demo fixture (regenerate with `python3 seed_demo.py`) ──────────────────
# The seed script is tracked; its output is not. Never ship a binary .db.
demo/

# ── Local AI tooling (per-developer, not project config) ───────────────────
# .agents/ is vendored skill content fetched from upstream — treat it like
# node_modules. Plans/ and opencode.json are local scratch and per-machine
# MCP wiring; the durable plan of record lives in Working Docs/.
.agents/
Plans/
opencode.json

# ── Per-machine local settings ──────────────────────────────────────────────
.claude/settings.local.json

# ── Graphify (regenerated by `graphify update .` — ~20 MB snapshots, not source)
graphify-out/

# ── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
*.swp
.aider*

# ── Scratch HTML captures (one-off preview pages) ───────────────────────────
docs/interactive_page.html
docs/page.html

# ── One-off OCR bench / processing scripts (project-specific, read .env) ─────
scripts/ocr_bench_ephemeral.py
scripts/ocr_full_mistral.py
