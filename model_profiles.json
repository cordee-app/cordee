{
  "_meta": {
    "last_reviewed": "2026-10-07",
    "review_after": "2027-01-07",
    "note": "Counselor knowledge base. 'tier_weight' ranks general capability bands; each model's 'tier' + 'strengths' drive recommendations. 'task_types' map task keywords to the strengths a good model should have. Any model NOT listed under 'models' falls back to 'provider_defaults' (then a neutral default), so newly-registered models still get ranked without editing this file. Refresh tiers/strengths/keywords when the model landscape shifts (target: quarterly, see review_after). Capabilities that are already declared elsewhere (context_window, vision, tools, cost, EU/provider) are read live from agent_config + model_caps.json and must NOT be duplicated here."
  },
  "tier_weight": { "frontier": 0, "strong": 1, "mid": 2, "light": 3 },
  "task_types": {
    "code_generation": {
      "label": "code generation",
      "keywords": ["implement", "code", "function", "api", "endpoint", "fix", "refactor", "debug", "class", "module", "unit test", "script", "build", "deploy", "bug", "compile"],
      "wants": ["coding", "agentic"],
      "needs_tools": true
    },
    "code_review": {
      "label": "code review",
      "keywords": ["review", "audit", "inspect", "code quality", "vulnerability", "lint", "pull request", "diff", "regression", "security review"],
      "wants": ["code_review", "reasoning", "coding"]
    },
    "legal_research": {
      "label": "legal research",
      "keywords": ["legal", "law", "compliance", "regulation", "krs", "gdpr", "contract", "clause", "attorney", "jurisdiction", "statute", "liability"],
      "wants": ["reasoning", "legal", "writing"]
    },
    "financial_modeling": {
      "label": "financial modeling",
      "keywords": ["budget", "cost", "revenue", "forecast", "roi", "financial", "profit", "margin", "cash flow", "valuation", "p&l", "expense"],
      "wants": ["reasoning", "math", "financial", "analysis"]
    },
    "technical_writing": {
      "label": "technical writing",
      "keywords": ["document", "write", "report", "summary", "spec", "readme", "guide", "description", "draft", "explain", "overview", "translate"],
      "wants": ["writing", "multilingual"]
    },
    "market_research": {
      "label": "market research",
      "keywords": ["market", "competitor", "sector", "industry", "trend", "customer", "survey", "landscape", "segment", "positioning", "go-to-market"],
      "wants": ["research", "analysis", "writing"]
    },
    "data_analysis": {
      "label": "data analysis",
      "keywords": ["data", "dataset", "statistics", "query", "sql", "chart", "metric", "aggregate", "pivot", "correlation", "regression analysis"],
      "wants": ["analysis", "reasoning", "math"]
    },
    "audio_dsp": {
      "label": "audio DSP",
      "keywords": ["audio", "signal", "frequency", "phase", "dsp", "acoustic", "waveform", "filter", "sample rate", "reverb", "latency", "buffer"],
      "wants": ["dsp", "reasoning", "math", "coding"]
    },
    "3d_design": {
      "label": "3D design",
      "keywords": ["3d", "cad", "geometry", "dimension", "mesh", "rendering", "solid", "surface", "blueprint", "extrude", "chamfer"],
      "wants": ["3d", "reasoning", "math"]
    },
    "vision_task": {
      "label": "vision / image",
      "keywords": ["image", "screenshot", "diagram", "photo", "picture", "ocr", "visual", "scan", "figure"],
      "wants": ["vision", "reasoning"],
      "needs_vision": true
    },
    "general": {
      "label": "general",
      "keywords": [],
      "wants": ["reasoning", "coding", "writing"]
    }
  },
